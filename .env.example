# Copy to .env and fill in what you need. Never commit real keys.

# Database. Defaults to a local SQLite file. Use PostgreSQL in production.
# DATABASE_URL=postgresql://user:password@host:5432/taskflow
DATABASE_URL=sqlite:///./taskflow.db

# Browser origins allowed to call the API in development.
CORS_ORIGINS=http://localhost:5173

# Create the 10-task demo project on first start.
SEED_ON_STARTUP=true
# Expose POST /api/demo/reset (handy for public demos).
ALLOW_DEMO_RESET=false

# AI suggestions: auto | openai | anthropic | heuristic
AI_PROVIDER=auto
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override, e.g. gpt-4o-mini or claude-haiku-4-5
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_RATE_LIMIT_PER_MINUTE=6
